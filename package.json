{
  "name": "imd-raffle",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Holder-gated on-chain raffle platform for Identity MD collectors",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "verify:mainnet": "hardhat run scripts/verify.ts --network mainnet",
    "etherscan:export": "hardhat run scripts/export-etherscan-input.ts",
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "lint": "npm run lint --prefix web"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "dotenv": "^17.4.2",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
